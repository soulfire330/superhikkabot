# Секреты бота. Файл кладём в /etc/superhikkabot.env с правами 600.
TELEGRAM_BOT_TOKEN=000:replace-me
LLM_API_KEY=replace-me
FIRECRAWL_API_KEY=replace-me
GROQ_API_KEY=replace-me

# Агент `dev` берёт ключи провайдера из своего окружения — им же отдаём один из них.
