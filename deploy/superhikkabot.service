[Unit]
Description=superhikkabot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=superhikka
WorkingDirectory=/opt/superhikkabot
EnvironmentFile=/etc/superhikkabot.env
Environment=CONFIG_PATH=/opt/superhikkabot/config.toml
Environment=HOME=/opt/superhikkabot/data/home
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/superhikkabot/bin/bot
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
